<?php

/**
 * @file
 * Contains markaspot_vision.module.
 */

use Drupal\markaspot_vision\Service\MediaAnalysisAccessGuard;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\markaspot_vision\Hook\HazardLevelHooks;
use Drupal\markaspot_vision\Service\OriginalImageStore;
use Drupal\markaspot_vision\Service\MediaIntakeScreening;
use Drupal\markaspot_vision\Service\ScreeningMarker;
use Drupal\markaspot_ai\Utility\BlurPolicy;
use Drupal\media\Entity\Media;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;

// Hosting policy is available even when the optional AI module is disabled.
if (!class_exists(BlurPolicy::class)) {
  require_once __DIR__ . '/../markaspot_ai/src/Utility/BlurPolicy.php';
}

/**
 * Implements hook_help().
 */
function markaspot_vision_help(string $route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.markaspot_vision':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('AI-powered image analysis for automatic categorization, hazard detection, and privacy screening using GPT-4 Vision.') . '</p>';
      return $output;

    default:
      return '';
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for media entities.
 */
function markaspot_vision_media_insert(EntityInterface $entity): void {
  if (!$entity instanceof MediaInterface) {
    return;
  }

  \Drupal::service('markaspot_vision.media_analysis_access_guard')->recordUpload($entity);
  // Fix the upload's tenant at the earliest trusted point; analysis, policy
  // and budget follow it from now on.
  \Drupal::service('markaspot_vision.media_tenant_scope')->bindUpload(
    $entity,
    \Drupal::requestStack()->getCurrentRequest(),
  );
}

/**
 * Implements hook_media_presave().
 */
function markaspot_vision_media_presave(MediaInterface $media): void {
  if ($media->bundle() !== 'request_image') {
    return;
  }
  // The bundle default, direct API writes and seed/import code must obey the
  // same rule as analysis: a stored report must exist before publication.
  if ($media->isPublished()) {
    $parents = $media->isNew() ? [] : \Drupal::entityTypeManager()->getStorage('node')
      ->getQuery()->accessCheck(FALSE)->condition('type', 'service_request')
      ->condition('field_request_media.target_id', $media->id())->range(0, 1)->execute();
    if (!$parents) {
      $media->setUnpublished();
    }
  }
  $store = \Drupal::keyValue(MediaIntakeScreening::STORE);
  $entry = $store->get($media->id());
  if (!$entry) {
    return;
  }
  $logger = \Drupal::logger('markaspot_vision');
  $required = BlurPolicy::isRequired($logger);
  $original = $media->getOriginal();
  if ($media->isPublished() && (!$original || !$original->isPublished())) {
    $metadata = json_decode((string) $media->get('field_ai_metadata')->value, TRUE) ?: [];
    $uri = $media->get('field_media_image')->entity?->getFileUri();
    $hash = $uri ? @hash_file('sha256', $uri) : FALSE;
    if ($entry['status'] !== 'done' || !ScreeningMarker::allowsPublication($metadata['intake_screening'] ?? [], $hash, $required)) {
      $media->setUnpublished();
      $logger->warning('Blocked direct publication of imported media @mid: privacy screening is incomplete or stale.', ['@mid' => $media->id()]);
    }
  }
  if (!$original || (string) $original->get('field_media_image')->target_id === (string) $media->get('field_media_image')->target_id) {
    return;
  }
  // A replacement source needs its own privacy screening, even on a media
  // entity whose earlier job has finished. Required blur also holds manually
  // controlled media.
  $store->set($media->id(), [
    'status' => 'pending', 'attempts' => 0, 'queued' => FALSE,
    'created' => \Drupal::time()->getCurrentTime(),
  ]);
  $media->setUnpublished();
}

/**
 * Implements hook_entity_field_access().
 */
function markaspot_vision_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if ($operation === 'edit' && $field_definition->getTargetEntityTypeId() === 'media'
    && in_array($field_definition->getName(), ['field_ai_metadata', 'field_ai_privacy_flag', 'field_ai_privacy_issues'], TRUE)) {
    return AccessResult::forbiddenIf(!$account->hasPermission('administer media'))->cachePerPermissions();
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_media_update().
 */
function markaspot_vision_media_update(MediaInterface $media): void {
  $store = \Drupal::keyValue(MediaIntakeScreening::STORE);
  $entry = $store->get($media->id());
  if ($entry) {
    // A successful controller analysis supersedes an earlier fingerprint,
    // including residual reblur of a completed import. The queue's own
    // intermediate marker must not finalize its still-pending AI work.
    $metadata = json_decode((string) $media->get('field_ai_metadata')->value, TRUE);
    $screening = $metadata['intake_screening'] ?? [];
    $uri = $media->get('field_media_image')->entity?->getFileUri();
    if (($screening['origin'] ?? '') === 'vision' && $uri
      && is_string($screening['source_sha256'] ?? NULL)
      && $screening['source_sha256'] === @hash_file('sha256', $uri)
      && (!BlurPolicy::isRequired(\Drupal::logger('markaspot_vision')) || ScreeningMarker::accepts($screening, $screening['source_sha256'], TRUE))) {
      $entry['privacy_screened'] = ($screening['processed'] ?? FALSE) === TRUE;
      $entry['processed'] = $screening['processed'] ?? FALSE;
      $entry['blur_required'] = $screening['blur_required'] ?? FALSE;
      $entry['prepared_hash'] = $screening['source_sha256'];
      $entry['status'] = 'done';
      $entry['analysis'] = 'existing';
      $store->set($media->id(), $entry);
    }
  }
  if ($entry && $entry['status'] === 'pending' && empty($entry['queued'])) {
    \Drupal::service('markaspot_vision.media_intake')->enqueue($media);
  }
}

/**
 * Implements hook_node_presave().
 *
 * Drupal 10 invokes this compatibility bridge. Drupal 11 discovers the native
 * attribute hook HazardLevelHooks::nodePresave() and skips this wrapper
 * through #[LegacyHook].
 */
#[LegacyHook]
function markaspot_vision_node_presave(NodeInterface $node): void {
  /** @var \Drupal\markaspot_vision\Hook\HazardLevelHooks $hooks */
  $hooks = \Drupal::service(HazardLevelHooks::class);
  $hooks->nodePresave($node);
}

/**
 * Implements hook_node_insert().
 *
 * Publishes safe media on node creation. The hazard level is set before the
 * write, in HazardLevelHooks::nodePresave().
 */
function markaspot_vision_node_insert(NodeInterface $node): void {
  _markaspot_vision_publish_safe_media($node);
  \Drupal::service('markaspot_vision.original_image_store')->bind($node);
}

/**
 * Implements hook_node_update().
 *
 * Publishes safe media on node update.
 */
function markaspot_vision_node_update(NodeInterface $node): void {
  // A request-ID repair must not replay business workflows or alter content.
  if (!empty($node->_markaspot_request_id_renumbering)) {
    return;
  }

  _markaspot_vision_publish_safe_media($node);
  \Drupal::service('markaspot_vision.original_image_store')->bind($node);
  if ($original = $node->getOriginal()) {
    \Drupal::service('markaspot_vision.orphan_upload_purger')->unpublishDetached($original, $node);
  }
}

/**
 * Publishes media on a service request based on privacy screening results.
 *
 * When require_ai_screening is enabled (default) or blur is required, media
 * stays unpublished until screening has completed successfully
 * (field_ai_metadata is set)
 * and no privacy flag or privacy issue was raised. This prevents unscreened
 * images from being published (privacy by design, fail-closed).
 *
 * When require_ai_screening is disabled and blur is optional, media is
 * published unless it has been explicitly flagged by AI. Imported images still
 * require their privacy checkpoint regardless of the analysis setting.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The report whose attached images may be published.
 * @param bool $retry_incomplete
 *   Defer incomplete images and queue a retry on report save. Workers pass
 *   FALSE so an incomplete analysis does not perpetually enqueue itself.
 */
function _markaspot_vision_publish_safe_media(NodeInterface $node, bool $retry_incomplete = TRUE): void {
  if ($node->bundle() !== 'service_request') {
    return;
  }
  $media_field = $node->get('field_request_media');
  if ($media_field->isEmpty()) {
    return;
  }

  $require_screening = \Drupal::config('markaspot_vision.settings')->get('require_ai_screening') ?? TRUE;

  $original_ids = [];
  if ($original = $node->getOriginal()) {
    foreach ($original->getTranslationLanguages() as $language) {
      $translation = $original->getTranslation($language->getId());
      if ($translation->hasField('field_request_media')) {
        $original_ids = array_merge($original_ids, array_column($translation->get('field_request_media')->getValue(), 'target_id'));
      }
    }
  }

  $manual_publication = \Drupal::keyValue('markaspot_open311.media_publication_manual');

  $handled = [];
  foreach ($media_field->referencedEntities() as $media) {
    if (isset($handled[$media->id()])) {
      continue;
    }
    $handled[$media->id()] = TRUE;
    $lock = \Drupal::lock();
    $mid = (int) $media->id();
    $new_reference = !in_array($mid, $original_ids);
    if ($retry_incomplete && !$media->isPublished() && !$manual_publication->has($mid)) {
      $pending = \Drupal::keyValue(MediaIntakeScreening::STORE)->get($mid);
      $incomplete = empty($media->get('field_ai_metadata')->value)
        || ($pending && ($pending['status'] !== 'done' || ($pending['analysis'] ?? '') === 'started'));
      if ($incomplete) {
        // Even acquire/release of a database semaphore inside this transaction
        // can block the controller until commit. Let it finish recording its
        // result and defer publication without touching that semaphore at all.
        // An earlier intake item may run before this report commits and see
        // no parent. This transaction needs its own guaranteed retry item.
        if (!\Drupal::queue(MediaIntakeScreening::QUEUE)->createItem(['media_id' => $mid])) {
          throw new \RuntimeException('Queue backend refused publication retry.');
        }
        continue;
      }
    }
    $lock_name = 'markaspot_open311.media_publication.' . $mid;
    $guarded = \Drupal::hasService('markaspot_vision.orphan_upload_purger')
      && \Drupal::service('markaspot_vision.orphan_upload_purger')->holdsPublicationLock($mid);
    if (!$guarded && !$lock->acquire($lock_name, 30)) {
      $lock->wait($lock_name, 5);
      if (!$lock->acquire($lock_name, 30)) {
        // Do not publish or write over an editor while they own the lock.
        \Drupal::logger('markaspot_vision')->warning('Deferred publication of media @mid: publication lock is busy.', ['@mid' => $media->id()]);
        try {
          if (!\Drupal::queue(MediaIntakeScreening::QUEUE)->createItem(['media_id' => (int) $media->id()])) {
            throw new \RuntimeException('Queue backend refused publication retry.');
          }
        }
        catch (\Throwable $e) {
          \Drupal::logger('markaspot_vision')->error('Could not queue publication retry for media @mid (@type).', [
            '@mid' => $media->id(), '@type' => get_class($e),
          ]);
        }
        continue;
      }
    }
    try {
      $media = \Drupal::entityTypeManager()->getStorage('media')->loadUnchanged($media->id());
      if (!$media) {
        continue;
      }
      // Media whose publication was explicitly set through the GeoReport media
      // publication API is under editorial (human-in-the-loop / trusted
      // consumer) control. That decision is authoritative and wins over the
      // whole AI publication pipeline — including the PII safety net below.
      // The gating permission is restrict-access, so we assume the consumer
      // knows what it is doing; automatic (un)publishing must not override it.
      //
      // Default to "not manually controlled" if the keyvalue lookup fails: a
      // backend hiccup must not abort the whole node save. The AI branches
      // below fail closed on PII on their own, so degrading to them is safe.
      try {
        $is_manual = (bool) $manual_publication->get($media->id());
      }
      catch (\Exception $e) {
        $is_manual = FALSE;
      }
      if ($is_manual) {
        continue;
      }

      $intake_store = \Drupal::keyValue(MediaIntakeScreening::STORE);
      $intake = $intake_store->get($media->id());
      $required = BlurPolicy::isRequired(\Drupal::logger('markaspot_vision'));
      // Controller uploads also carry checkpoints, even without intake work.
      // A policy change must hold those originals before report publication.
      $metadata = json_decode((string) $media->get('field_ai_metadata')->value, TRUE) ?: [];
      $marker = $metadata['intake_screening'] ?? [];
      if (!$intake && $required && $marker) {
        $uri = $media->get('field_media_image')->entity?->getFileUri();
        $hash = $uri ? @hash_file('sha256', $uri) : FALSE;
        if (!ScreeningMarker::accepts($marker, $hash, TRUE)) {
          $intake = [
            'status' => 'pending', 'attempts' => 0, 'queued' => FALSE,
            'created' => \Drupal::time()->getCurrentTime(),
          ];
          if ($hash !== FALSE && ($marker['source_sha256'] ?? '') === $hash) {
            if (($marker['origin'] ?? '') === 'vision') {
              $intake['analysis'] = 'existing';
            }
            elseif (isset($marker['analysis']) && $marker['analysis'] !== 'started') {
              $intake['analysis'] = $marker['analysis'];
            }
          }
          $intake_store->set($media->id(), $intake);
          \Drupal::service('markaspot_vision.media_intake')->enqueue($media);
        }
      }
      if ($intake && isset($intake['prepared_hash'])) {
        $uri = $media->get('field_media_image')->entity?->getFileUri();
        $hash = $uri ? @hash_file('sha256', $uri) : FALSE;
        $source_changed = $hash !== FALSE && $intake['prepared_hash'] !== $hash;
        $policy_changed = $required && (empty($intake['processed']) || empty($intake['blur_required']));
        if ($hash === FALSE || $intake['prepared_hash'] !== $hash || $policy_changed) {
          $intake['privacy_screened'] = FALSE;
          $intake['status'] = $source_changed ? 'failed' : 'pending';
          $intake['queued'] = FALSE;
          $intake['attempts'] = 0;
          unset($intake['next_attempt']);
          if (!$source_changed) {
            unset($intake['prepared_hash']);
          }
          else {
            \Drupal::logger('markaspot_vision')->error('Imported media @mid source changed after privacy screening; holding it for review.', ['@mid' => $media->id()]);
          }
          $intake_store->set($media->id(), $intake);
        }
      }
      $intake_held = $intake && ($intake['status'] !== 'done' || ($intake['analysis'] ?? '') === 'started');
      // A fallback alone is not AI screening. Use the same strict outcome as
      // citizen uploads: real blur or completed analysis, otherwise hold.
      $blur_completed = !empty($intake['privacy_screened']) && ($intake['processed'] ?? FALSE) === TRUE;
      $analysis_completed = in_array($intake['analysis'] ?? '', ['done', 'existing'], TRUE);
      $ai_completed = $intake
        ? ($blur_completed || $analysis_completed)
        : !empty($media->get('field_ai_metadata')->value);
      $has_privacy_flag = !empty($media->get('field_ai_privacy_flag')->value);
      $privacy_issues = $media->hasField('field_ai_privacy_issues')
        ? trim((string) $media->get('field_ai_privacy_issues')->value)
        : '';
      $has_privacy_hold = $has_privacy_flag || $privacy_issues !== '';

      $new_unguarded_reference = !$guarded && $new_reference;
      if ($retry_incomplete && (!$ai_completed || $intake_held || $new_unguarded_reference)) {
        // The analysis transaction may finish while this report insert is
        // still invisible to it. A database queue item written in the report
        // transaction becomes visible with the report and retries publication.
        // New unguarded links also need a check when a concurrent last-report
        // removal unpublishes an already screened image before this commit.
        if (!\Drupal::queue(MediaIntakeScreening::QUEUE)->createItem(['media_id' => (int) $media->id()])) {
          throw new \RuntimeException('Queue backend refused publication retry.');
        }
      }

      $report_holds = \Drupal::keyValue('markaspot_vision.report_media_hold');
      if (!$node->isPublished() || $intake_held) {
        if ($media->isPublished()) {
          if (!$node->isPublished() && !$has_privacy_hold && !$intake_held) {
            $report_holds->set($media->id(), TRUE);
          }
          $media->setUnpublished();
          $media->save();
        }
        continue;
      }
      $restore = (bool) $report_holds->get($media->id());
      if ($restore && !$has_privacy_hold && (!($require_screening || $required) || $ai_completed)) {
        $media->setPublished();
        $media->save();
        $report_holds->delete($media->id());
        continue;
      }

      if ($has_privacy_hold && $media->isPublished()) {
        // Safety net: unpublish media held for PII (e.g. published by
        // ImageProcessingController before a late or inconsistent detection).
        $media->setUnpublished();
        $media->save();
      }
      elseif (!$media->isPublished()) {
        if ($require_screening || $required) {
          // Strict mode: only publish screened media without privacy issues.
          if ($ai_completed && !$has_privacy_hold) {
            $media->setPublished();
            $media->save();
          }
        }
        else {
          // Legacy mode: publish unless explicitly flagged.
          if (!$has_privacy_hold) {
            $media->setPublished();
            $media->save();
          }
        }
      }
    }
    finally {
      if (!$guarded) {
        $lock->release($lock_name);
      }
    }
  }
}

/**
 * Implements hook_file_download().
 *
 * Unblurred originals open only while the site keeps them, and only for
 * accounts that may edit the report owning the original; every view is
 * logged. Any other private file is not ours.
 */
function markaspot_vision_file_download(string $uri): array|int|null {
  if (!str_starts_with($uri, OriginalImageStore::DIRECTORY . '/')) {
    return NULL;
  }
  /** @var \Drupal\markaspot_vision\Service\OriginalImageStore $store */
  $store = \Drupal::service('markaspot_vision.original_image_store');
  if (!$store->isEnabled()) {
    return -1;
  }
  $original = $store->findByUri($uri);
  $media = $original ? Media::load($original['mid']) : NULL;
  $account = \Drupal::currentUser();
  if (!$media || !$store->canView($media, $account)) {
    return -1;
  }
  $store->logView($original['mid'], $account);
  return [
    'Content-Type' => $original['mime'],
    'Cache-Control' => 'private, no-store',
    'X-Content-Type-Options' => 'nosniff',
    // Only images render inline; anything else would be a document of its own.
    'Content-Disposition' => str_starts_with($original['mime'], 'image/') ? 'inline' : 'attachment',
  ];
}

/**
 * Implements hook_cron().
 */
function markaspot_vision_cron(): void {
  \Drupal::service('markaspot_vision.orphan_upload_purger')->purge();
  \Drupal::service('markaspot_vision.media_intake')->recoverPending();
  \Drupal::service('markaspot_vision.original_image_store')->purgeExpired();
}

/**
 * Implements hook_media_delete().
 */
function markaspot_vision_media_delete(MediaInterface $media): void {
  \Drupal::service('keyvalue.expirable')->get(MediaAnalysisAccessGuard::STORE)->delete($media->uuid());
  \Drupal::keyValue(MediaIntakeScreening::STORE)->delete($media->id());
  \Drupal::keyValue('markaspot_vision.report_media_hold')->delete($media->id());
  \Drupal::keyValue('markaspot_open311.media_publication_manual')->delete($media->id());
  \Drupal::service('markaspot_vision.original_image_store')->delete((int) $media->id());
  \Drupal::service('markaspot_vision.media_tenant_scope')->forget($media);
}

/**
 * Implements hook_node_predelete().
 */
function markaspot_vision_node_predelete(NodeInterface $node): void {
  \Drupal::service('markaspot_vision.orphan_upload_purger')->protectReportDeletion($node);
}

/**
 * Implements hook_node_delete().
 *
 * The originals a report owns pass to a report still showing the photo, or
 * go with it.
 */
function markaspot_vision_node_delete(NodeInterface $node): void {
  if ($node->bundle() === 'service_request') {
    \Drupal::service('markaspot_vision.original_image_store')->releaseOwnedBy((int) $node->id());
    \Drupal::service('markaspot_vision.orphan_upload_purger')->unpublishDetached($node);
    \Drupal::service('markaspot_vision.orphan_upload_purger')->releaseReferences($node);
  }
}

/**
 * Implements hook_entity_presave().
 */
function markaspot_vision_entity_presave(EntityInterface $entity): void {
  \Drupal::service('markaspot_vision.orphan_upload_purger')->protectReferences($entity);
}

/**
 * Implements hook_entity_insert().
 */
function markaspot_vision_entity_insert(EntityInterface $entity): void {
  \Drupal::service('markaspot_vision.orphan_upload_purger')->releaseReferences($entity);
}

/**
 * Implements hook_entity_update().
 */
function markaspot_vision_entity_update(EntityInterface $entity): void {
  \Drupal::service('markaspot_vision.orphan_upload_purger')->releaseReferences($entity);
}
